# Copy to .env (or run pnpm setup:local). Never commit .env.
# Leave the key and model empty to use manual receiving without AWS.
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID=""
AWS_BEARER_TOKEN_BEDROCK=""
# Pick a model or inference profile that supports Bedrock Converse tool use.
# Claude models need the inference-profile ID, e.g. us.anthropic.claude-haiku-5-5.
# Use a Bedrock API key for the same region. This adapter does not use IAM
# access-key/secret-key pairs. No VITE_ or NEXT_PUBLIC_ prefix on credentials.
